# Tencent Hy-MT2 1.8B translation model for Ollama with a working chat template.
# Ollama's auto-converted template for this GGUF is broken (the prompt never reaches the model),
# so create the model from this file instead of running the hf.co name directly:
#   ollama pull hf.co/tencent/Hy-MT2-1.8B-GGUF:Q4_K_M
#   ollama create hy-mt2:1.8b -f models/Modelfile.hy-mt2-1.8b
FROM hf.co/tencent/Hy-MT2-1.8B-GGUF:Q4_K_M
TEMPLATE """{{- if .System }}<｜hy_begin▁of▁sentence｜>{{ .System }}<｜hy_place▁holder▁no▁3｜>{{- else }}<｜hy_begin▁of▁sentence｜>{{- end }}
{{- range .Messages }}
{{- if eq .Role "user" }}<｜hy_User｜>{{ .Content }}
{{- else if eq .Role "assistant" }}<｜hy_Assistant｜>{{ .Content }}<｜hy_place▁holder▁no▁2｜>
{{- end }}
{{- end }}<｜hy_Assistant｜>"""
PARAMETER stop <｜hy_place▁holder▁no▁2｜>
PARAMETER stop <｜hy_end▁of▁sentence｜>
PARAMETER temperature 0.7
PARAMETER top_p 0.6
PARAMETER top_k 20
PARAMETER repeat_penalty 1.05
