# Copy to config.env and edit. run.sh loads it automatically; config.env is git-ignored.

# Ollama model used for translation. Smaller = faster; 8B-class models are fluent enough for subtitles.
#   ollama pull qwen3:8b
# Translation-specialised alternatives (see README "翻譯模型怎麼選"):
#   hy-mt2:7b          4.6 GB, ~0.5 s/sentence  (create it with models/Modelfile.hy-mt2-7b first)
#   hy-mt2:1.8b        1.1 GB, ~0.2 s/sentence  (models/Modelfile.hy-mt2-1.8b)
#   translategemma:12b 8.1 GB, ~0.9 s/sentence  (ollama pull translategemma:12b)
OLLAMA_MODEL=qwen3:8b

# Ollama endpoint (change if Ollama runs on another machine).
OLLAMA_URL=http://127.0.0.1:11434

# whisper.cpp model path. Leave empty to use the newest large-v3-turbo file found in models/.
WHISPER_MODEL=

# whisper-server port and CPU threads.
WHISPER_PORT=8178
WHISPER_THREADS=4
